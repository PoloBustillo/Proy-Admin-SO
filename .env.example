# Copia este archivo a .env.local. La clave debe tener 32 caracteres o más.
SESSION_PASSWORD=reemplaza-esta-clave-de-sesion-con-32-caracteres-o-mas

# Acceso local sin Google. En la VPS ponlo en false cuando Google ya funcione.
AUTH_DEV_LOGIN=true

# URL pública de la app. Google la usa como base del redirect.
# En la VPS puede ser http://IP:3000. La base no usa este nombre.
AUTH_URL=http://localhost:3000

# PostgreSQL en esta misma máquina. No hace falta un dominio.
DATABASE_URL=postgres://127.0.0.1:5432/nucleo

# Credenciales de Google Cloud (OAuth, tipo "aplicación web").
# Redirect autorizado: http://localhost:3000/api/auth/google/callback
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# En la laptop, sin FTP, los archivos quedan en data/vps.
# En la VPS usa ftp hacia 127.0.0.1.
STORAGE_DRIVER=local

# FTP en la misma VPS
# STORAGE_DRIVER=ftp
# FTP_HOST=127.0.0.1
# FTP_PORT=21
# FTP_USER=nucleo
# FTP_PASSWORD=
# FTP_SECURE=false
# FTP_ROOT=nucleo
# LOCAL_STORAGE_ROOT=/home/nucleo/nucleo

# Segundos máximos de compilación o ejecución. Tope interno: 120.
RUN_TIMEOUT_SEC=8
